{
  "title": "パスワード認証の仕組みと進化",
  "description": "平文保存の危険性から、ハッシュ化、ソルト、そしてパスキー（WebAuthn）までの流れを解説するアニメーション集",
  "aspectRatio": "16:9",
  "scenarios": [
    {
      "id": "plaintext-signup",
      "title": "1. 平文保存によるユーザー登録（アンチパターン）",
      "description": "入力されたパスワードがそのままデータベースに平文（プレーンテキスト）で保存されてしまう危険な例",
      "nodes": [
        { "id": "narrator", "label": "結月ゆかり", "image": "/actors/Yukari_yamarisu_0000.png", "frame": false, "scale": 1.25, "x": 10, "y": 30 },
        { "id": "client", "label": "ユーザー端末", "sublabel": "ブラウザ/アプリ", "icon": "laptop", "connectTo": ["server"], "x": 32, "y": 55, "color": "blue" },
        { "id": "server", "label": "Webサーバー", "sublabel": "API", "icon": "server", "connectTo": ["db"], "x": 62, "y": 55, "color": "purple" },
        { "id": "db", "label": "データベース", "sublabel": "Usersテーブル", "icon": "database", "connectTo": [], "x": 88, "y": 55, "color": "rose" }
      ],
      "steps": [
        {
          "duration": 2200,
          "caption": "ユーザーがサインアップフォームにIDとパスワードを入力して送信します",
          "action": {
            "type": "message",
            "from": "client",
            "to": "server",
            "label": "ユーザー登録リクエスト",
            "payload": "user: alice, pass: mypassword123",
            "icon": "key",
            "status": "warning"
          }
        },
        {
          "duration": 2200,
          "caption": "サーバーは何の暗号化も施さず、受け取った平文パスワードをそのままDBに保存しようとします",
          "action": {
            "type": "transform",
            "target": "server",
            "label": "加工なしで処理",
            "badge": "平文のまま",
            "result": "pass: mypassword123",
            "icon": "alert-triangle"
          }
        },
        {
          "duration": 2400,
          "caption": "平文パスワードがデータベースに書き込まれます（DB漏洩時に即アカウント侵害！）",
          "action": {
            "type": "message",
            "from": "server",
            "to": "db",
            "label": "INSERT INTO users",
            "payload": "mypassword123",
            "icon": "database",
            "status": "danger"
          }
        },
        {
          "duration": 2000,
          "caption": "DBに平文で保存完了。管理者はもちろん、万一DB流出が起きた場合全パスワードが丸見えになります",
          "action": {
            "type": "state",
            "target": "db",
            "label": "平文保存完了 (危険⚠️)",
            "value": "alice | mypassword123",
            "status": "danger"
          }
        }
      ]
    },
    {
      "id": "hashed-signup",
      "title": "2. 一方向ハッシュ関数によるパスワード保護",
      "description": "サーバー側で不可逆なハッシュ関数を通してハッシュ値に変換してから保存する安全な例",
      "nodes": [
        { "id": "client", "label": "ユーザー端末", "sublabel": "ブラウザ", "icon": "laptop", "x": 18, "y": 50, "color": "blue" },
        { "id": "server", "label": "Webサーバー", "sublabel": "認証ロジック", "icon": "server", "x": 50, "y": 50, "color": "purple" },
        { "id": "db", "label": "データベース", "sublabel": "Usersテーブル", "icon": "database", "x": 82, "y": 50, "color": "emerald" }
      ],
      "steps": [
        {
          "duration": 2200,
          "caption": "HTTPS暗号化通信で安全にパスワードがサーバーに送信されます",
          "action": {
            "type": "message",
            "from": "client",
            "to": "server",
            "label": "登録リクエスト (HTTPS)",
            "payload": "user: alice, pass: mypassword123",
            "icon": "lock",
            "status": "safe"
          }
        },
        {
          "duration": 2500,
          "caption": "サーバー側で一方向ハッシュ関数（Argon2やbcrypt）を通し、不可逆な文字列に変換します",
          "action": {
            "type": "transform",
            "target": "server",
            "label": "ハッシュ化を実行",
            "badge": "Argon2id",
            "result": "$argon2id$v=19$m=65536...",
            "icon": "shield-check"
          }
        },
        {
          "duration": 2200,
          "caption": "元のパスワードは即座に破棄され、復元不可能なハッシュ値だけがDBに送られます",
          "action": {
            "type": "message",
            "from": "server",
            "to": "db",
            "label": "ハッシュ値を格納",
            "payload": "$argon2id$v=19$m=65536...",
            "icon": "shield",
            "status": "safe"
          }
        },
        {
          "duration": 2000,
          "caption": "DB流出が起きても元のパスワードは復元できません！",
          "action": {
            "type": "result",
            "target": "db",
            "status": "success",
            "label": "ハッシュ値の安全な保存完了"
          }
        }
      ]
    },
    {
      "id": "passkey-flow",
      "title": "3. パスキー（WebAuthn / FIDO2）の登録と公開鍵",
      "description": "端末内の生体認証と公開鍵暗号を用いたパスワードレス認証の流れ",
      "nodes": [
        { "id": "authenticator", "label": "認証器 / 端末", "sublabel": "Touch ID / Face ID", "icon": "smartphone", "x": 18, "y": 50, "color": "cyan" },
        { "id": "server", "label": "Webサーバー", "sublabel": "RP (Relying Party)", "image": "/actors/avatar-bot.svg", "flipX": true, "x": 50, "y": 50, "color": "purple" },
        { "id": "db", "label": "データベース", "sublabel": "公開鍵ストア", "icon": "database", "x": 82, "y": 50, "color": "emerald" }
      ],
      "steps": [
        {
          "duration": 2000,
          "caption": "サーバーがチャレンジ（使い捨てのランダムな値）を発行します",
          "action": {
            "type": "message",
            "from": "server",
            "to": "authenticator",
            "label": "チャレンジ発行",
            "payload": "challenge: a8f9...3b",
            "icon": "key",
            "status": "info"
          }
        },
        {
          "duration": 2400,
          "caption": "端末内で生体認証を行い、秘密鍵と公開鍵のペアを安全な領域で生成します",
          "action": {
            "type": "transform",
            "target": "authenticator",
            "label": "生体確認＆鍵ペア生成",
            "badge": "Touch ID / Secure Enclave",
            "result": "秘密鍵(端末内保管) + 公開鍵",
            "icon": "shield-check"
          }
        },
        {
          "duration": 2200,
          "caption": "秘密鍵は端末の外に絶対出さず、公開鍵だけをサーバーに送信します",
          "action": {
            "type": "message",
            "from": "authenticator",
            "to": "server",
            "label": "公開鍵 + 署名の送信",
            "payload": "PublicKey: MFkwEwY...",
            "icon": "shield",
            "status": "safe"
          }
        },
        {
          "duration": 2000,
          "caption": "サーバーは公開鍵をDBに保存。パスワード自体が存在しないため盗まれる心配ゼロ！",
          "action": {
            "type": "result",
            "target": "server",
            "status": "success",
            "label": "パスキー登録完了！"
          }
        }
      ]
    }
  ]
}
