{
  "title": "パスワード認証の仕組みと進化",
  "description": "平文保存の危険性から可逆暗号、ハッシュ、ソルト、ペッパー、ストレッチング、そしてパスキー（WebAuthn）までの全14シナリオ完全解説集",
  "aspectRatio": "16:9",
  "scenarios": [
    {
      "id": "plaintext-signup",
      "title": "1. 平文パスワードの登録（アンチパターン）",
      "description": "入力されたパスワードが暗号化されず、そのまま平文（プレーンテキスト）でDBに保存される危険な例",
      "nodes": [
        { "id": "narrator", "label": "結月ゆかり", "image": "/actors/Yukari_yamarisu_0000.png", "frame": false, "scale": 1.25, "x": 10, "y": 30 },
        { "id": "client", "label": "ユーザー端末", "sublabel": "ブラウザ/アプリ", "icon": "laptop", "connectTo": ["server"], "color": "blue", "x": 32, "y": 55 },
        { "id": "server", "label": "Webサーバー", "sublabel": "API", "icon": "server", "connectTo": ["db"], "color": "purple", "x": 62, "y": 55 },
        { "id": "db", "label": "データベース", "sublabel": "Usersテーブル", "icon": "database", "connectTo": [], "color": "rose", "x": 88, "y": 55 }
      ],
      "steps": [
        {
          "duration": 2200,
          "caption": "ユーザーがサインアップフォームにIDとパスワードを入力して送信します",
          "action": {
            "type": "message",
            "from": "client",
            "to": "server",
            "label": "ユーザー登録リクエスト",
            "payload": "user: alice, pass: mypassword123",
            "icon": "key",
            "status": "warning"
          }
        },
        {
          "duration": 2200,
          "caption": "サーバーは何の暗号化も施さず、受け取った平文パスワードをそのままDBに保存しようとします",
          "action": {
            "type": "transform",
            "target": "server",
            "label": "加工なしで処理",
            "badge": "平文のまま",
            "result": "pass: mypassword123",
            "icon": "alert-triangle"
          }
        },
        {
          "duration": 2400,
          "caption": "平文パスワードがデータベースにそのまま書き込まれます（DB漏洩時に即全アカウント侵害！）",
          "action": {
            "type": "message",
            "from": "server",
            "to": "db",
            "label": "INSERT INTO users",
            "payload": "mypassword123",
            "icon": "database",
            "status": "danger"
          }
        },
        {
          "duration": 2000,
          "caption": "DBに平文で保存完了。管理者はもちろん、万一DB流出が起きた場合全パスワードが丸見えになります",
          "action": {
            "type": "state",
            "target": "db",
            "label": "平文保存完了 (危険⚠️)",
            "value": "alice | mypassword123",
            "status": "danger"
          }
        }
      ]
    },
    {
      "id": "plaintext-auth",
      "title": "2. 平文パスワードによる認証",
      "description": "平文保存された環境でのログイン処理。DBから取得した文字列と入力文字列をそのまま単純比較する",
      "nodes": [
        { "id": "narrator", "label": "結月ゆかり", "image": "/actors/Yukari_yamarisu_0000.png", "frame": false, "scale": 1.25, "x": 10, "y": 30 },
        { "id": "client", "label": "ユーザー端末", "icon": "laptop", "connectTo": ["server"], "color": "blue", "x": 32, "y": 55 },
        { "id": "server", "label": "Webサーバー", "icon": "server", "connectTo": ["db"], "color": "purple", "x": 62, "y": 55 },
        { "id": "db", "label": "データベース", "icon": "database", "connectTo": [], "color": "rose", "x": 88, "y": 55 }
      ],
      "steps": [
        {
          "duration": 2200,
          "caption": "ユーザーがログイン画面からIDとパスワードを送信します",
          "action": {
            "type": "message",
            "from": "client",
            "to": "server",
            "label": "POST /login",
            "payload": "user: alice, pass: mypassword123",
            "icon": "key",
            "status": "info"
          }
        },
        {
          "duration": 2200,
          "caption": "サーバーはDBからaliceの平文パスワードを取得します",
          "action": {
            "type": "message",
            "from": "db",
            "to": "server",
            "label": "SELECT pass FROM users",
            "payload": "mypassword123",
            "icon": "database",
            "status": "warning"
          }
        },
        {
          "duration": 2500,
          "caption": "入力された平文とDBの平文をそのまま単純比較（===）して照合します",
          "action": {
            "type": "compare",
            "target": "server",
            "label": "平文パスワード照合",
            "left": { "label": "入力値", "value": "mypassword123" },
            "right": { "label": "DB値", "value": "mypassword123" },
            "operator": "===",
            "matched": true
          }
        },
        {
          "duration": 2000,
          "caption": "一致したためログイン成功。しかし通信経路やDBの安全性が極めて低く危険です",
          "action": {
            "type": "result",
            "target": "server",
            "label": "ログイン成功 (平文照合)",
            "status": "success"
          }
        }
      ]
    },
